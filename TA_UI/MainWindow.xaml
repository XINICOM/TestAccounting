<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="TA_UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:TA_UI"
        xmlns:views="using:TA_UI.Views"
        xmlns:controls="using:CommunityToolkit.WinUI.Controls"
        xmlns:ui="using:CommunityToolkit.WinUI"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="TA_UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TitleBar x:Name="AppTitleBar"
                  Grid.Row="0"
                  Title="Test_Accounting"
                  Subtitle="UI"
                  IsBackButtonVisible="True"
                  IsPaneToggleButtonVisible="True">
            <TitleBar.IconSource>
                <FontIconSource Glyph="&#xEF15;" />
            </TitleBar.IconSource>
            <TitleBar.Content>
                <TextBlock Text="this is an application" />
            </TitleBar.Content>
        </TitleBar>
        <Grid Grid.Row="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TreeView x:Name="TreeView"
                          ItemsSource="{x:Bind FileFolderNodes}"
                          Grid.Column="0"
                          CanDrag="False"
                          Height="Auto"
                          SelectionMode="Multiple">
                    <TreeView.ItemTemplate>
                        <DataTemplate x:DataType="local:FileFolderNode">
                            <TreeViewItem ItemsSource="{x:Bind Children}"
                                          Content="{x:Bind Name}"
                                          CanDrag="False"
                                          DragStarting="TreeViewItem_DragStarting"/>
                        </DataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Grid>
            <StackPanel Grid.Column="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="5">
                <Button Content="dialog"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Click="DialogButton_Click"
                    Style="{StaticResource AccentButtonStyle }" />
                <Button Grid.Row="2"
                    Content="back drop"
                    Click="BackdropButton_Click" />
                <Button x:Name="BrowserBtn"
                    Grid.Row="2"
                    Content="Browser"
                    Click="SelectFolder" />
            </StackPanel>

        </Grid>
    </Grid>



</Window>
